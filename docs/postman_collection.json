            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_code\": \"P0099\",\n  \"product_name\": \"Produk Contoh 100ml\",\n  \"stock\": 10,\n  \"price\": 12000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('productId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
